# Configuracion local / Docker
DB_HOST=localhost
DB_USER=root
DB_PASS=tu_contraseña_aqui
DB_NAME=parkingcontrol_db
DB_PORT=3306

# Configuracion Railway MySQL
# Railway puede inyectar estas variables automaticamente al conectar el servicio MySQL.
MYSQLHOST=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
MYSQLPORT=3306

# Seguridad y servidor
JWT_SECRET=una_clave_secreta_muy_larga_y_segura
PORT=8800

# CORS
# En produccion usa la URL publica exacta de tu frontend.
CORS_ORIGIN=https://tu-frontend.vercel.app
# Alternativa si prefieres otro nombre de variable.
FRONTEND_URL=https://tu-frontend.vercel.app

# Solo si quieres permitir dominios *.up.railway.app como origen en produccion.
ALLOW_RAILWAY_DOMAINS=false
