# ============================================
# Configuración del Backend - ParkingControl
# ============================================
# IMPORTANTE: Nunca subas este archivo a git.
# En producción, usa secretos del entorno (Railway, Vercel, etc.)

# --- Base de Datos ---
# Para desarrollo local con Docker:
DB_HOST=db
DB_USER=root
DB_PASS=UnaClaveSeguraYUnica123!
DB_NAME=parkingcontrol_db
DB_PORT=3306

# Estas variables son inyectadas automáticamente por Railway
# al conectar un servicio MySQL. No las configures manualmente.
MYSQLHOST=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
MYSQLPORT=3306

# --- Seguridad ---
# Clave secreta para firmar tokens JWT.
# En producción: usar un valor aleatorio de al menos 256 bits.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=una_clave_secreta_muy_larga_y_segura_minimo_64_caracteres

# --- Puerto del servidor ---
PORT=8800

# --- CORS (Control de acceso) ---
# En producción, especifica EXACTAMENTE la URL de tu frontend:
CORS_ORIGIN=https://tu-frontend.vercel.app
FRONTEND_URL=https://tu-frontend.vercel.app

# Solo habilitar en producción si necesitas permitir dominios Railway.
ALLOW_RAILWAY_DOMAINS=false

# --- Entorno ---
# development | production
NODE_ENV=development
